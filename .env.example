# ==============================================================================
# .env.example — variables d'environnement de l'agent IAP
#
# USAGE :
#   cp .env.example .env
#   # éditer .env avec les vraies valeurs
#   docker compose -f agent/docker-compose.dev.yml up
#   # ou pour le dev JVM local :
#   export $(grep -v '^#' .env | xargs)
#   ./mvnw spring-boot:run                 (dans agent/)
#
# Le fichier .env est gitignored — ne jamais committer les vraies valeurs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Agent
# ------------------------------------------------------------------------------
IAP_INSTANCE_ID=agent-local-dev

# ------------------------------------------------------------------------------
# Kafka
# ------------------------------------------------------------------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Port exposé sur l'hôte par docker-compose (utile si 9092 est déjà pris)
KAFKA_HOST_PORT=9092

# ------------------------------------------------------------------------------
# Adapter WEF (Windows Event Forwarding)
# ------------------------------------------------------------------------------
IAP_AGENT_ADAPTERS_WEF_ENABLED=false
IAP_WEF_SOURCE_ID=ad://change.me
# Hôte du collecteur WEF. Vide si l'agent tourne sur ce collecteur.
IAP_WEF_REMOTE_HOST=

# ------------------------------------------------------------------------------
# Adapter DirSync / LDAP (fallback ou source complémentaire)
# ------------------------------------------------------------------------------
IAP_AGENT_ADAPTERS_DIRSYNC_ENABLED=false
IAP_LDAP_URL=ldap://change.me:389
IAP_LDAP_BASE_DN=DC=change,DC=me
IAP_LDAP_BIND_DN=CN=svc-dirsync,OU=ServiceAccounts,DC=change,DC=me
IAP_LDAP_BIND_PASSWORD=change_me
IAP_LDAP_POLL_INTERVAL=15

# ------------------------------------------------------------------------------
# Adapter Webhook
# ------------------------------------------------------------------------------
IAP_AGENT_ADAPTERS_WEBHOOK_ENABLED=false
IAP_WEBHOOK_PORT=8080

# ------------------------------------------------------------------------------
# Adapter Syslog
# ------------------------------------------------------------------------------
IAP_AGENT_ADAPTERS_SYSLOG_ENABLED=false
IAP_SYSLOG_PORT=6514

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Niveau de log pour com.instantaccessprovider (DEBUG | INFO | WARN | ERROR)
# Laisser INFO en prod, mettre DEBUG en dev
IAP_LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# Spring
# ------------------------------------------------------------------------------
# Fichier de règles métier du client (resource-mappings).
# Pointer vers un fichier YAML nommé librement selon le client/env.
# Exemples :
#   IAP_CONFIG_FILE=classpath:context-resolver-rules.yml   (dev local)
#   IAP_CONFIG_FILE=file:/etc/iap/acme-corp.yml            (prod K8s)
IAP_CONFIG_FILE=classpath:context-resolver-rules.yml

# Profils Spring actifs (généralement vide — la config passe par IAP_CONFIG_FILE)
SPRING_PROFILES_ACTIVE=
